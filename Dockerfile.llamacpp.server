# Dockerfile.llamacpp.server
# Builds a custom image with llama-server + modelctl

ARG LLAMACPP_IMAGE
FROM ${LLAMACPP_IMAGE}

# Install Python for modelctl
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# Copy and install modelctl
COPY model-manager/modelctl/ /opt/modelctl/modelctl/
COPY model-manager/pyproject.toml /opt/modelctl/pyproject.toml
RUN pip3 install /opt/modelctl --break-system-packages --no-cache-dir

# Entrypoint — starts server with or without active model
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Volume for model files (mounted at runtime)
RUN mkdir -p /models

ENTRYPOINT ["/entrypoint.sh"]

# modelctl is available inside the container:
#   docker compose exec llama-server modelctl list
#   docker compose exec llama-server modelctl activate <id>
