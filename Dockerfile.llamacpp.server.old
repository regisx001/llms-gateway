# Dockerfile.llamacpp.server
# Builds a custom image with llama-server + modelctl CLI + modelctl-api

ARG LLAMACPP_IMAGE
FROM ${LLAMACPP_IMAGE}

# Install Python for modelctl + FastAPI
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# ── Bun (for building the SvelteKit frontend) ─────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Copy and install modelctl-core (lib)
COPY libs/modelctl-core/ /opt/modelctl-core/
RUN pip3 install /opt/modelctl-core --break-system-packages --no-cache-dir

# Copy and install modelctl (CLI app)
COPY apps/modelctl/ /opt/modelctl/
RUN pip3 install /opt/modelctl --break-system-packages --no-cache-dir

# Copy and install modelctl-orch (orchestration lib — needed by modelctl-api)
COPY libs/modelctl-orch/ /opt/modelctl-orch/
RUN pip3 install /opt/modelctl-orch --break-system-packages --no-cache-dir

# ── Copy modelctl-api skeleton so web build has a target directory ───
#     Placed at /opt/apps/modelctl-api to match the repo-relative path
#     that the SvelteKit vite config references (../apps/modelctl-api/static).
COPY apps/modelctl-api/ /opt/apps/modelctl-api/

# ── Build SvelteKit frontend (output → /opt/apps/modelctl-api/static) ─
COPY web/ /opt/web/
RUN cd /opt/web \
    && bun install --frozen-lockfile \
    && bun run build \
    && cd / \
    && rm -rf /opt/web

# ── Move built API tree to final location ─────────────────────────────
RUN mv /opt/apps/modelctl-api /opt/modelctl-api

# Install modelctl-api (now includes static frontend assets)
RUN pip3 install /opt/modelctl-api --break-system-packages --no-cache-dir && \
    pip3 install uvicorn --break-system-packages --no-cache-dir

# Entrypoint — starts llama-server + modelctl-api
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Volume for model files (mounted at runtime)
RUN mkdir -p /models

EXPOSE 8080 8000

ENTRYPOINT ["/entrypoint.sh"]

# Tools available inside the container:
#   docker compose exec llama-server modelctl list
#   docker compose exec llama-server modelctl activate <id>
#   curl http://localhost:8000/health
#   curl http://localhost:8000/api/v1/models
